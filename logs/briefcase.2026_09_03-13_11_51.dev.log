# This project was generated with 0.4.1 using template: https://github.com/beeware/briefcase-template @ v0.4.1
[tool.briefcase]
project_name = "arsenal"
bundle = "com.arsenal"
version = "2.5.0"
url = "https://github.com/vshadrov/arsenal"
license.file = "LICENSE"
author = "Arsenal"
author_email = "shadrov@pbstin.ru"

[tool.briefcase.app.arsenal]
formal_name = "Arsenal"
description = "Arsenal"
long_description = "Arsenal methodology is for assessing the dynamics of the risk of dangerous behavior and the commission of repeated socially dangerous acts by patients with mental disorders, primarily those undergoing compulsory treatment and involuntarily hospitalized. The main focus of the technique is to identify targets for therapeutic intervention and track the changes that were achieved during this intervention."
sources = [
    "src/arsenal",
]
test_sources = [
    "tests",
]
console_app = true
main_module = "arsenal.app"
main_function = "main"

requires = [
    "textual>=8.2.8",
    "rich>=15.0.0",
    "openpyxl>=3.1.5",
    "matplotlib>=3.11.1",
    "numpy>=2.5.2",
    "pandas>=3.0.5",
    "plotext>=6.0.0",
    "scikit-learn>=1.9.0",
    "scipy>=1.18.1",
]

