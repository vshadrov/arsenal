pyproject.toml:
[project]
name = "arsenal"
version = "2.5.2"
description = "Программа предназначена для структурированной оценки специалистами в области психического здоровья динамики риска опасного поведения у пациентов с психическими расстройствами."
license = "GPL-3.0-or-later"
license-files = ["LICENSE"]
authors = [
    { name = "Шадров Василий Валерьевич", email = "shadrov@pbstin.ru" }
]
requires-python = ">=3.11,<3.12"

dependencies = [
    "textual>=8.2.8",
    "rich>=15.0.0",
    "openpyxl>=3.1.5",
    "numpy==1.24.3",
    "scipy==1.10.1",
    "matplotlib==3.7.1",
    "scikit-learn==1.2.2",
    "pandas==2.0.3",
    "plotext>=5.2.8,<6.0.0",
]

[tool.briefcase]
project_name = "arsenal"
bundle = "com.arsenal"
version = "2.5.2"
url = "https://github.com/vshadrov/arsenal"

[tool.briefcase.app.arsenal]
formal_name = "Арсенал"
description = "МОДРОП Арсенал"
long_description = "Программа предназначена для структурированной оценки специалистами в области психического здоровья динамики риска опасного поведения у пациентов с психическими расстройствами."
sources = ["src/arsenal"]
test_sources = ["tests"]
main_module = "arsenal.app"
main_function = "main"
console_app = true

# Прямая проверенная ссылка на бинарный дистрибутив Python 3.11 под Linux x86_64
support_package = "https://github.com -O ~/.cache/briefcase/support/cpython-3.11.3+20230507-x86_64-unknown-linux-gnu-install_only.tar.gz"

requires = [
    "textual>=8.2.8",
    "rich>=15.0.0",
    "openpyxl>=3.1.5",
    "numpy==1.24.3",
    "scipy==1.10.1",
    "matplotlib==3.7.1",
    "scikit-learn==1.2.2",
    "pandas==2.0.3",
    "plotext>=5.2.8,<6.0.0",
]

test_requires = ["pytest>=9.1.1"]

[tool.briefcase.app.arsenal.linux]
categories = ["Office"]
terminal = true
icon = "resources/images/arsenal"

